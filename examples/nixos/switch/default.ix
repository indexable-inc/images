{index}:
# A single NixOS VM consumed by flake.nix for the native `ix apply` loop:
# `ix apply .#devbox` builds this configuration on ix and activates it on
# the running VM in place. Edit `configuration.nix`, run it again, and the
# VM converges.
index.lib.mkVm {
  name = "devbox";
  modules = [./configuration.nix];
}
