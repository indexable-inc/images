// One hyperion game server behind three proxies, each proxy on its own VM:
//
//   players -> hyperion-proxy-0 \
//   players -> hyperion-proxy-1  >-- hyperion-game (private)
//   players -> hyperion-proxy-2 /
//
// Apply the whole thing with one command:
//
//   ix apply .#hyperion-game .#hyperion-proxy-0 .#hyperion-proxy-1 .#hyperion-proxy-2
//
// Traffic direction is what makes this simple. Proxies dial the game server,
// so the game server needs no public address at all and lives only on the
// east-west group. The proxy count is the `replicas` digit below, and the game
// server does not change when it grows, because it has supported several
// connected proxies since hyperion#940.
export default ({ index, hyperion }) => {
  const packages = {
    _module: {
      args: {
        // Guests are Linux whatever the machine running `ix apply` is.
        //
        // An event is compiled in rather than chosen by a runtime flag, so
        // which game this fleet serves is exactly this one attribute.
        hyperionGameServer: hyperion.packages["x86_64-linux"].smash,
        hyperionProxy: hyperion.packages["x86_64-linux"]["hyperion-proxy"],
      },
    },
  };

  return index.lib.mkFleet({
    // One private segment. A VM outside it has no route to the game server,
    // which is the only thing keeping an unproxied client off it. The proxies
    // resolve the game server by name on that segment, so nothing here carries
    // an address.
    defaults: [
      { ix: { networking: { groups: ["hyperion"] } } },
      packages,
      import("./pki.nix"),
      hyperion.nixosModules["game-server"],
      hyperion.nixosModules.proxy,
    ],
    nodes: {
      "hyperion-game": { modules: [import("./game.nix")] },
      // Interchangeable, and `replicas` is how that is said rather than
      // implied. `mkFleet` expands one spec into `hyperion-proxy-0` through
      // `hyperion-proxy-2`, so scaling is one digit and no proxy can drift
      // from its siblings by being edited on its own -- which is exactly what
      // three copy-pasted node entries permit. Players land on whichever proxy
      // their address resolves to; each holds its own player connections and
      // multiplexes them onto the one link to the game server.
      //
      // What this does not buy, because it cannot: nothing here places the
      // proxies on different hosts. `ix apply` has no way to ask, and the
      // scheduler takes the host reporting the most free memory with no
      // account of a placement it has just made, so one apply lands every
      // proxy on one host -- measured, both proxies on hil-compute-1 with the
      // game server on hil-compute-3. ENG-11225. Until that is expressible,
      // three replicas are three failure domains for the proxy process and one
      // for the hardware under it, and this file cannot say otherwise.
      "hyperion-proxy": {
        modules: [import("./proxy.nix")],
        replicas: 3,
      },
    },
  });
};
