{index}: let
  inherit (index.lib) mkVm;

  # One GitHub token, declared once in the account secret store and
  # consumed by every agent VM as `/run/secrets/github/token`:
  #
  #   ix secret set github_token --file github/token --mode 0400
  #   ix apply .#agent-0 .#agent-1 .#agent-2 --secret github_token
  #
  # A fine-grained GitHub PAT or GitHub App installation token scoped to
  # the repos the agents touch is the right credential here, not a
  # personal classic PAT.
  agent = name:
    mkVm {
      inherit name;
      modules = [./agent.nix];
    };
in {
  # Three interchangeable agent VMs. None of them runs `gh auth login`;
  # they all consume the same attached token, so a fourth is one more
  # name here.
  nixosConfigurations =
    builtins.foldl' (acc: vm: acc // vm.nixosConfigurations) {}
    (map agent ["agent-0" "agent-1" "agent-2"]);
}
