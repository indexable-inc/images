{
  index,
  src ? ./.,
}:
# `mkDev` consumes the dev module in ./dev.nix and returns the same shape
# as `mkVm`, so `ix apply` can consume it. `src` defaults to ./. for
# direct imports, while the standalone flake passes `self`; it gets
# materialized at /ix on the VM for recursion.
index.lib.mkDev {
  module = ./dev.nix;
  inherit src;
}
