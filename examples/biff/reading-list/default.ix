// `ix apply` reads this VM through flake.nix. The application package is built
// by clj-nix in flake.nix, so Maven artifacts are fixed by deps-lock.json;
// nothing is fetched when the service starts.
export default ({ index, biffApp }) =>
  index.lib.mkVm({
    name: "biff-reading-list",
    // The SQLite state directory is the point of this example. Keep ix's
    // rollback snapshot even if the platform default changes later.
    deployment: { snapshot: true },
    modules: [import("./service.nix")({ biffApp })],
  });
