{
  "big_change_label": "ci/big-change",
  "extended_validation_seconds": 10800,
  "queue_start_seconds": 300,
  "repositories": {
    "indexable-inc/index": {
      "costly_paths": [
        "Cargo.lock",
        "**/Cargo.lock",
        "flake.lock",
        "**/flake.lock",
        "rust-toolchain.toml",
        "**/rust-toolchain.toml",
        "rust-toolchain",
        "**/rust-toolchain"
      ],
      "managed_workflows": [
        ".github/workflows/check.yml",
        ".github/workflows/closure-gate.yml"
      ]
    },
    "indexable-inc/ix": {
      "costly_paths": [
        "Cargo.lock",
        "**/Cargo.lock",
        "flake.lock",
        "**/flake.lock",
        "rust-toolchain.toml",
        "**/rust-toolchain.toml",
        "rust-toolchain",
        "**/rust-toolchain",
        "lib/workspace-cargo-unit.nix",
        "nix/flake/outputs/workspace.nix",
        "nix/packages/workspace-*.nix"
      ],
      "managed_workflows": [
        ".github/workflows/ci.yml"
      ]
    }
  },
  "routine_validation_seconds": 300,
  "setup_allowance_seconds": 120,
  "termination_grace_seconds": 10
}
