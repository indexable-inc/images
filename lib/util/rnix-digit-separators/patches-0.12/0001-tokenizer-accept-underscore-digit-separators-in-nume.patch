From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: Andrew Gazelka <andrew@ix.dev>
Date: Sun, 19 Jul 2026 01:30:59 -0700
Subject: [PATCH] tokenizer: accept underscore digit separators in numeric
 literals

Lex `1_000`, `1_000.000_1`, and `2.5e1_0` -- the dialect index's
patched nix lexer accepts (packages/nix/nix/patches/0014-libexpr-
accept-underscore-digit-separators-in-numeri.patch). alejandra, statix,
and deadnix all parse nix through rnix, and none of them can format or
lint a tree that uses separators until their tokenizer takes them; the
index packages patch this into each tool's vendored rnix crate at build
time (lib/util/rnix-digit-separators).

Semantics mirror the flex patch exactly: one or more `_` between two
digits of the integer part, the fraction, or the exponent; never
leading (`_1_000` stays an identifier) or trailing (`1_` still lexes as
`1` then `_`). Token text keeps the separators, so a formatter passes
them through verbatim.

Refs indexable-inc/index#3638

diff --git a/src/tokenizer.rs b/src/tokenizer.rs
index 6cddb7f..a388d8b 100644
--- a/src/tokenizer.rs
+++ b/src/tokenizer.rs
@@ -444,10 +444,10 @@ impl Tokenizer<'_> {
                 TOKEN_STRING_START
             }
             '0'..='9' => {
-                self.consume(|c| ('0'..='9').contains(&c));
+                self.consume_digits(1);
                 if self.peek() == Some('.') {
                     self.next().unwrap();
-                    self.consume(|c| ('0'..='9').contains(&c));
+                    self.consume_digits(0);
                     self.consume_scientific()
                 } else {
                     TOKEN_INTEGER
@@ -457,13 +457,35 @@ impl Tokenizer<'_> {
         })
     }
 
+    /// Consume a run of digits, allowing `_` digit separators strictly
+    /// between digits (`1_000`, never leading or trailing). `digits` counts
+    /// digits the caller already consumed (the number arm matches the first
+    /// one); returns the total.
+    fn consume_digits(&mut self, mut digits: usize) -> usize {
+        loop {
+            digits += self.consume(|c| ('0'..='9').contains(&c));
+            if digits == 0 {
+                break;
+            }
+            let separators = self.remaining().chars().take_while(|c| *c == '_').count();
+            let separated = self.remaining()[separators..].chars().next();
+            if separators == 0 || !separated.is_some_and(|c| ('0'..='9').contains(&c)) {
+                break;
+            }
+            for _ in 0..separators {
+                self.next().unwrap();
+            }
+        }
+        digits
+    }
+
     fn consume_scientific(&mut self) -> SyntaxKind {
         if self.peek() == Some('e') || self.peek() == Some('E') {
             self.next().unwrap();
             if self.peek() == Some('-') || self.peek() == Some('+') {
                 self.next().unwrap();
             }
-            if self.consume(|c| ('0'..='9').contains(&c)) == 0 {
+            if self.consume_digits(0) == 0 {
                 return TOKEN_ERROR;
             }
         }
