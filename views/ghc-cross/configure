  done
IFS=$as_save_IFS

  ;;
esac
fi
GHC=$ac_cv_path_GHC
if test -n "$GHC"; then
  { $as_echo "$as_me:${as_lineno-$LINENO}: result: $GHC" >&5
$as_echo "$GHC" >&6; }
else
