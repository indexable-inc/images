{
#if defined(HAVE_NLIST_H)
    if(nlist(argv[0], xYzzY1) == 0 && xYzzY1[0].n_value != 0)
        return 1;
    if(nlist(argv[0], xYzzY2) == 0 && xYzzY2[0].n_value != 0)
