        exit 1
    fi

    BuildArch=`echo "$build" | sed 's/-.*//'`
    BuildVendor=`echo "$build" | sed -e 's/.*-\(.*\)-.*/\1/'`
    BuildOS=`echo "$build" | sed 's/.*-//'`

    else


case "$build_cpu" in
  aarch64*|arm64*)
    BuildArch="aarch64"
    ;;
  alpha*)
    BuildArch="alpha"
    ;;
  arm*)
    BuildArch="arm"
    ;;
  hppa1.1*)
