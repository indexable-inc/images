        if ! "$CXX" -c actest.cpp; then
            as_fn_error $? "Failed to compile test object" "$LINENO" 5
        fi

        try_libs() {
                        { $as_echo "$as_me:${as_lineno-$LINENO}: checking for linkage against '${3}'" >&5
$as_echo_n "checking for linkage against '${3}'... " >&6; }
                        p="`"$CXX" --print-file-name ${2}`"
            d="`dirname "$p"`"
            if "$CC" -o actest actest.o ${1} -L"$d" 2>/dev/null; then
                CXX_STD_LIB_LIBS="${3}"
                                                                                                if test "$d" = "."; then d=""; fi
                CXX_STD_LIB_LIB_DIRS="$d"
                CXX_STD_LIB_DYN_LIB_DIRS="$d"
                { $as_echo "$as_me:${as_lineno-$LINENO}: result: success" >&5
$as_echo "success" >&6; }
                true
            else
                { $as_echo "$as_me:${as_lineno-$LINENO}: result: failed" >&5
$as_echo "failed" >&6; }
                false
            fi
        }
        case $CXX_STD_LIB_FLAVOUR in
        c++)
            try_libs "-lc++ -lc++abi" "libc++.so" "c++ c++abi" || \
            try_libs "-lc++ -lc++abi -lpthread" "libc++.so" "c++ c++abi pthread" || \
            try_libs "-lc++ -lcxxrt" "libc++.so" "c++ cxxrt" ||
            as_fn_error $? "Failed to find C++ standard library" "$LINENO" 5 ;;
        stdc++)
            try_libs "-lstdc++" "libstdc++.so" "stdc++" || \
            try_libs "-lstdc++ -lsupc++" "libstdc++.so" "stdc++ supc++" || \
            as_fn_error $? "Failed to find C++ standard library" "$LINENO" 5 ;;
        esac

        rm -f actest.cpp actest.o actest
    fi

    cd ..
    rm -R actest.tmp





fi
ac_config_files="$ac_config_files mk/system-cxx-std-lib-1.0.conf"



