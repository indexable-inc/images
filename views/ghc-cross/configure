                -XNoImplicitPrelude \
                -odir actmp-ghc-toolchain -hidir actmp-ghc-toolchain \
                -package-env=- \
                utils/ghc-toolchain/exe/Main.hs -o acghc-toolchain || as_fn_error $? "Could not compile ghc-toolchain" "$LINENO" 5
            GHC_TOOLCHAIN_BIN="./acghc-toolchain"
