if grep 'conwip' conftest.out > /dev/null 2>&1 ; then
  # The goods
  SortCmd="$fp_prog_sort"
else
  # Summink else..pick next one.
  { $as_echo "$as_me:${as_lineno-$LINENO}: WARNING: $fp_prog_sort looks like a non-*nix sort, ignoring it" >&5
$as_echo "$as_me: WARNING: $fp_prog_sort looks like a non-*nix sort, ignoring it" >&2;}
