# Flags passed to the Haskell compiler




if test "$TargetOS" != "ghcjs"; then

    # Annoyingly, Darwin's <cstddef> includes <version> and APFS is
    # case-insensitive. Consequently, it will end up #including the
    # VERSION file generated by the configure script on the second
    # and subsequent runs of the configure script.
    # See #23116.
    mkdir -p actest.tmp
    cd actest.tmp

    # If this is non-empty then assume that the user has specified these
    # manually.
    if test -z "$CXX_STD_LIB_LIBS"; then
        cat >actest.cpp <<-EOF
#include <iostream>
#if defined(_LIBCPP_VERSION)
libc++
#elif defined(__GLIBCXX__)
libstdc++
#else
unknown
#endif
EOF
        { $as_echo "$as_me:${as_lineno-$LINENO}: checking C++ standard library flavour" >&5
$as_echo_n "checking C++ standard library flavour... " >&6; }
        if ! "$CXX" -E actest.cpp -o actest.out; then
            rm -f actest.cpp actest.out
            as_fn_error $? "Failed to compile test program" "$LINENO" 5
        fi

                if grep "libc++" actest.out >/dev/null; then
            CXX_STD_LIB_FLAVOUR="c++"
            { $as_echo "$as_me:${as_lineno-$LINENO}: result: libc++" >&5
$as_echo "libc++" >&6; }
        elif grep "libstdc++" actest.out >/dev/null; then
            CXX_STD_LIB_FLAVOUR="stdc++"
            { $as_echo "$as_me:${as_lineno-$LINENO}: result: libstdc++" >&5
$as_echo "libstdc++" >&6; }
        else
            rm -f actest.cpp actest.out
            as_fn_error $? "Unknown C++ standard library implementation." "$LINENO" 5
        fi
        rm -f actest.cpp actest.out

                                cat >actest.cpp <<-EOF
#include <iostream>
int main(int argc, char** argv) {
    std::cout << "hello world\n";
    return 0;
}
