    *-linux*|*-freebsd*)

    { $as_echo "$as_me:${as_lineno-$LINENO}: checking whether Cc linker supports -Wl,--no-as-needed" >&5
$as_echo_n "checking whether Cc linker supports -Wl,--no-as-needed... " >&6; }
    echo 'int f(int a) {return 2*a;}' > conftest.a.c
