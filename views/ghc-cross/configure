  set dummy $fp_version1; shift
  fp_num1=""
  test $# = 0 || { fp_num1="$1"; shift; }
  test x"$fp_num1" = x && fp_num1="0"
  fp_version1="$*"

  set dummy $fp_version2; shift
  fp_num2=""
  test $# = 0 || { fp_num2="$1"; shift; }
  test x"$fp_num2" = x && fp_num2="0"
  fp_version2="$*"

