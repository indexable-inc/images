    { id: 'signal', label: 'terminal signal', sub: 'done, failed, blocked', col: 2, row: 0 },
    { id: 'verify', label: 'parent verifies', sub: 'evidence, not status', col: 3, row: 0 }
  ]}
  edges={[['dispatch', 'work'], ['work', 'signal'], ['signal', 'verify']]}
/>

## Non-goals

Choosing which orchestrator wins; the contract is orchestrator-neutral by
design.

