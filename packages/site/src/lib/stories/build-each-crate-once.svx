  <rect x="220" y="30" width="110" height="40" rx="8" fill="none" stroke="var(--status-input-wanted)" stroke-width="2" />
  <text x="275" y="54" text-anchor="middle" font-family="var(--font-mono)" font-size="11" fill="var(--status-input-wanted)">api: rebuilt</text>
  <rect x="220" y="140" width="110" height="40" rx="8" fill="var(--code)" stroke="var(--rule)" />
  <text x="275" y="164" text-anchor="middle" font-family="var(--font-mono)" font-size="11" fill="var(--fg-muted)">util: cached</text>
  <rect x="420" y="30" width="120" height="40" rx="8" fill="none" stroke="var(--status-input-wanted)" stroke-width="2" />
  <text x="480" y="54" text-anchor="middle" font-family="var(--font-mono)" font-size="11" fill="var(--status-input-wanted)">cli: rebuilt</text>
  <rect x="420" y="140" width="120" height="40" rx="8" fill="var(--code)" stroke="var(--rule)" />
  <text x="480" y="164" text-anchor="middle" font-family="var(--font-mono)" font-size="11" fill="var(--fg-muted)">tests: cached</text>
  <path d="M 150 95 L 220 58" stroke="var(--fg-faint)" stroke-width="1.5" fill="none" />
  <path d="M 150 115 L 220 152" stroke="var(--fg-faint)" stroke-width="1.5" fill="none" />
