{
  "extends": "./tsconfig.json",
  "compilerOptions": {
    // `$lib` must resolve inside staging/ here: the gate typechecks the tree
    // the agent edited, not the live one it will be promoted into.
    "paths": {
      "$lib": ["./staging/lib"],
      "$lib/*": ["./staging/lib/*"]
    }
  },
  "include": ["staging/**/*.ts", "staging/**/*.svelte"]
}
