{
  "name": "mkapp-app",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite --host",
    "build": "vite build",
    "test": "node --test src/lib/*.test.ts",
    "test:staging": "node --test staging/lib/*.test.ts",
    "check": "svelte-check --tsconfig ./tsconfig.json && tsc -p tsconfig.node.json && npm run test",
    "check:staging": "svelte-check --tsconfig ./tsconfig.staging.json && tsc -p tsconfig.node.json && npm run test:staging",
    "promote": "rsync -a --delete staging/ src/"
  },
  "devDependencies": {
    "@internationalized/date": "^3.12.2",
    "@lucide/svelte": "^1.25.0",
    "@sveltejs/vite-plugin-svelte": "^6.1.0",
    "@tailwindcss/vite": "^4.3.3",
    "@tanstack/table-core": "^8.21.3",
    "@tsconfig/svelte": "^5.0.4",
    "@types/node": "^24.13.2",
    "bits-ui": "^2.18.1",
    "clsx": "^2.1.1",
    "embla-carousel-svelte": "^8.6.0",
    "mode-watcher": "^1.1.0",
    "paneforge": "^1.0.2",
    "svelte": "^5.35.0",
    "svelte-check": "^4.2.0",
    "svelte-sonner": "^1.1.1",
    "tailwind-merge": "^3.6.0",
    "tailwind-variants": "^3.2.2",
    "tailwindcss": "^4.3.3",
    "tw-animate-css": "^1.4.0",
    "typescript": "^5.8.0",
    "vaul-svelte": "^1.0.0-next.7",
    "vite": "^7.0.0"
  }
}
