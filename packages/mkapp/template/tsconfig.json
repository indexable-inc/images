{
  "extends": "@tsconfig/svelte/tsconfig.json",
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "bundler",
    "verbatimModuleSyntax": true,
    // `node` alongside `vite/client` because the gate runs the `*.test.ts`
    // files next to the app code with `node --test`, and they import
    // `node:test`. One tsconfig covering the whole tree beats a third one whose
    // only job is to see two files.
    "types": ["vite/client", "node"],
    // The same test files import `./history.ts` WITH the extension: node strips
    // types without rewriting specifiers, so an extensionless relative import
    // would not resolve at runtime. Vite and svelte-check accept both spellings.
    "allowImportingTsExtensions": true,
    "noEmit": true,
    "strict": true,
    "skipLibCheck": true,
    "paths": {
      "$lib": ["./src/lib"],
      "$lib/*": ["./src/lib/*"]
    }
  },
  "include": ["src/**/*.ts", "src/**/*.svelte"]
}
