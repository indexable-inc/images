From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: Andrew Gazelka <andrew@ix.dev>
Date: Mon, 20 Jul 2026 09:37:56 -0700
Subject: [PATCH] termio: hang up child process groups when spawn-time killpg
 EPERMs

On macOS the spawn-time process group being signaled at surface close
can contain only the root-owned login(1) wrapper: the interactive shell
moves itself into its own job-control process group at startup. killpg
then fails with EPERM having reached nobody, the code path logged it as
expected and moved on, and the shell survived its surface indefinitely,
spinning against a revoked tty. Observed live: login root-owned in pgid
N, shell in pgid N+1, killpg(N) EPERM, shell alive 21 hours later.

Fall back to enumerating the direct children via proc_listchildpids
(returns a pid count, not bytes; verified empirically on macOS 26) and
hanging up each child's current process group.

Refs indexable-inc/index#3768
(patch authored by an AI agent via Claude Code, model Claude Opus 4.5)

diff --git a/src/termio/Exec.zig b/src/termio/Exec.zig
index 0f35b5787..a9eae9e24 100644
--- a/src/termio/Exec.zig
+++ b/src/termio/Exec.zig
@@ -1166,7 +1166,17 @@ const Subprocess = struct {
                     if ((comptime builtin.target.os.tag.isDarwin()) and
                         err == .PERM)
                     {
-                        log.debug("killpg failed with EPERM, expected on Darwin and ignoring", .{});
+                        // EPERM here can mean the hangup reached NOBODY: on
+                        // macOS the spawn-time process group can contain only
+                        // the root-owned login(1) wrapper, while the
+                        // interactive shell has long since moved into its own
+                        // job-control process group. Silently accepting the
+                        // EPERM leaves that shell running forever against a
+                        // dead pty (observed as closed-surface shells
+                        // surviving for hours). Hang up each direct child's
+                        // CURRENT process group instead before moving on.
+                        log.debug("killpg failed with EPERM, hanging up child process groups", .{});
+                        killChildProcessGroups(pid);
                         break :killpg;
                     }
 
@@ -1186,6 +1196,36 @@ const Subprocess = struct {
         }
     }
 
+    /// Darwin fallback for killPid: when killpg on the spawn-time process
+    /// group fails with EPERM (root-owned login(1) is its only member the
+    /// caller cannot signal), enumerate the direct children and hang up
+    /// each child's current process group. proc_listchildpids returns the
+    /// NUMBER OF PIDS written (not bytes; verified empirically on macOS 26).
+    fn killChildProcessGroups(pid: c.pid_t) void {
+        comptime std.debug.assert(builtin.target.os.tag.isDarwin());
+
+        var pids: [256]c_int = undefined;
+        const count = proc_listchildpids(pid, &pids, @sizeOf(@TypeOf(pids)));
+        if (count <= 0) {
+            log.warn("proc_listchildpids found no children pid={} ret={}", .{ pid, count });
+            return;
+        }
+
+        for (pids[0..@min(@as(usize, @intCast(count)), pids.len)]) |child| {
+            const child_pgid = c.getpgid(child);
+            if (child_pgid < 0) continue;
+            switch (posix.errno(c.killpg(child_pgid, c.SIGHUP))) {
+                .SUCCESS => log.debug("hung up child process group pgid={}", .{child_pgid}),
+                else => |err| log.warn(
+                    "failed to hang up child process group child={} pgid={} err={}",
+                    .{ child, child_pgid, err },
+                ),
+            }
+        }
+    }
+
+    extern "c" fn proc_listchildpids(ppid: c.pid_t, buffer: ?*anyopaque, buffersize: c_int) c_int;
+
     fn getpgid(pid: c.pid_t) ?c.pid_t {
         // Get our process group ID. Before the child pid calls setsid
         // the pgid will be ours because we forked it. Its possible that
