From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: Andrew Gazelka <andrew@ix.dev>
Date: Mon, 20 Jul 2026 09:37:56 -0700
Subject: [PATCH] macos: fire undo-close expiry via main-queue GCD timer

Timer.scheduledTimer arms the calling thread's run loop in default mode,
so an expiry registered off the main thread never fires and one on the
main thread sits out modal and event-tracking sessions. Undo-close
retention keeps the closed terminal's process tree fully alive until
expiry fires, so a timer that never fires leaks live sessions without
bound: observed dozens of hidden surfaces tens of hours old against a
5-second undo-timeout. A GCD timer on the main queue fires regardless
of the arming thread and of run-loop mode.

Refs indexable-inc/index#3768
(patch authored by an AI agent via Claude Code, model Claude Opus 4.5)

diff --git a/macos/Sources/Helpers/ExpiringUndoManager.swift b/macos/Sources/Helpers/ExpiringUndoManager.swift
index 3b1abd44a..06595a667 100644
--- a/macos/Sources/Helpers/ExpiringUndoManager.swift
+++ b/macos/Sources/Helpers/ExpiringUndoManager.swift
@@ -100,7 +100,18 @@ private class ExpiringTarget {
     private(set) weak var target: AnyObject?
 
     /// Timer that triggers expiration after the specified duration.
-    private var timer: Timer?
+    ///
+    /// A main-queue GCD timer rather than a run-loop `Timer`:
+    /// `Timer.scheduledTimer` arms the *calling* thread's run loop in
+    /// `.default` mode, so a registration made off the main thread never
+    /// fires, and one made on the main thread sits out modal and event-
+    /// tracking sessions. Undo-close retention keeps the closed terminal's
+    /// process tree fully alive until this fires, so a timer that never
+    /// fires leaks live sessions unboundedly (observed: dozens of hidden
+    /// surfaces tens of hours old against a 5s undo-timeout). A GCD timer
+    /// on the main queue fires regardless of the arming thread and of
+    /// run-loop mode.
+    private var timer: DispatchSourceTimer?
 
     /// The undo manager from which to remove actions when this target expires.
     private weak var undoManager: UndoManager?
@@ -114,11 +125,13 @@ private class ExpiringTarget {
     init(_ target: AnyObject? = nil, expiresAfter duration: Duration, in undoManager: UndoManager) {
         self.target = target
         self.undoManager = undoManager
-        self.timer = Timer.scheduledTimer(
-            withTimeInterval: duration.timeInterval,
-            repeats: false) { [weak self] _ in
+        let timer = DispatchSource.makeTimerSource(queue: .main)
+        timer.schedule(deadline: .now() + duration.timeInterval)
+        timer.setEventHandler { [weak self] in
             self?.expire()
         }
+        timer.activate()
+        self.timer = timer
     }
 
     /// Manually expires the target, removing all associated undo actions and invalidating the timer.
@@ -128,7 +141,7 @@ private class ExpiringTarget {
     func expire() {
         target = nil
         undoManager?.removeAllActions(withTarget: self)
-        timer?.invalidate()
+        timer?.cancel()
         timer = nil
     }
 
