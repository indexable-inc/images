From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: Andrew Gazelka <andrew.gazelka@gmail.com>
Date: Wed, 8 Jul 2026 18:11:34 -0700
Subject: [PATCH] tests/functional: test build status directory

Exercises the goal-graph lifecycle end to end on a direct (non-daemon)
store: a stale graph file with a dead pid is pruned; a sleeping dep
build appears in the flat view with an unchanged entry shape and a
why-chain from the requested top goal; the `--graph` view shows the
running dep, the waiting top goal and the waiter edge between them;
the dep flips to `done` once the top goal starts building; and the
status directory drains when the build is stopped.

Refs indexable-inc/index#2485
Assisted-by: Claude <noreply@anthropic.com>

diff --git a/tests/functional/build-status.nix b/tests/functional/build-status.nix
new file mode 100644
index 000000000..a35629ea5
--- /dev/null
+++ b/tests/functional/build-status.nix
@@ -0,0 +1,21 @@
+with import ./config.nix;
+
+# A two-level chain whose builders sleep, so the graph stays observable long
+# enough for `nix store builds` to see a running dep, a waiting top goal, and
+# later the dep in its completed state.
+let
+  dep = mkDerivation {
+    name = "build-status-dep";
+    buildCommand = ''
+      sleep 10
+      echo dep > $out
+    '';
+  };
+in
+mkDerivation {
+  name = "build-status-sleeper";
+  buildCommand = ''
+    cat ${dep} > $out
+    sleep 60
+  '';
+}
diff --git a/tests/functional/build-status.sh b/tests/functional/build-status.sh
new file mode 100644
index 000000000..9dee63fe1
--- /dev/null
+++ b/tests/functional/build-status.sh
@@ -0,0 +1,127 @@
+#!/usr/bin/env bash
+
+source common.sh
+
+# The build status directory is daemon-independent shared state on the
+# filesystem, so this test exercises the direct (non-daemon) store: it starts a
+# sleeping build chain and checks that `nix store builds` sees it without
+# connecting to a daemon.
+TODO_NixOS
+
+enableFeatures "build-status-dir"
+
+clearStore
+
+nixExpr=build-status.nix
+
+topDrv=$(nix-instantiate "$nixExpr")
+echo "top derivation is $topDrv"
+
+statusDir=$NIX_STATE_DIR/status
+
+# Stale graph files: a file whose recorded pid is dead must be ignored and
+# removed. Use a just-reaped subshell pid so it is guaranteed dead.
+(exit 0) &
+deadPid=$!
+wait "$deadPid"
+mkdir -p "$statusDir"
+cat > "$statusDir/graph-$deadPid.json" <<EOF
+{"pid": $deadPid, "user": null, "uid": null, "roots": [], "goals": []}
+EOF
+[[ $(nix store builds --json | jq 'length') == 0 ]]
+[[ ! -e $statusDir/graph-$deadPid.json ]]
+
+# Start the (sleeping) build chain in the background.
+nix build --file "$nixExpr" --no-link &
+buildPid=$!
+
+cleanup() {
+    kill "$buildPid" 2> /dev/null || true
+    wait "$buildPid" 2> /dev/null || true
+}
+trap cleanup EXIT
+
+# Poll until the dep build is running (the graph file is written when the
+# worker loop first settles, and the dep starts doing real work immediately).
+found=
+for _ in $(seq 1 150); do
+    if nix store builds --json | jq -e \
+        'any(.[]; .type == "build" and (.drvPath | endswith("build-status-dep.drv")))' > /dev/null; then
+        found=1
+        break
+    fi
+    sleep 0.2
+done
+[[ -n $found ]]
+
+# Flat view: grab the running dep entry and assert its (unchanged) shape.
+entry=$(nix store builds --json | jq \
+    'map(select(.drvPath | endswith("build-status-dep.drv"))) | .[0]')
+echo "$entry" | jq .
+
+[[ $(echo "$entry" | jq -r '.type') == build ]]
+[[ $(echo "$entry" | jq -r '.storePath') == null ]]
+[[ $(echo "$entry" | jq -r '.drvPath') == *build-status-dep.drv ]]
+# The why-chain must run from the requested top goal down to the dep.
+[[ $(echo "$entry" | jq '.why.chain | length') -ge 2 ]]
+[[ $(echo "$entry" | jq -r '.why.chain | first') == *build-status-sleeper.drv ]]
+[[ $(echo "$entry" | jq -r '.why.chain | last') == *build-status-dep.drv ]]
+[[ $(echo "$entry" | jq -r '.why.cause') == outputsMissing ]]
+[[ $(echo "$entry" | jq -r '.why.rootDrvPath') == *build-status-sleeper.drv ]]
+# The top goal is not running, so it must not appear in the flat view.
+nix store builds --json | jq -e \
+    'all(.[]; .drvPath | endswith("build-status-sleeper.drv") | not)' > /dev/null
+# The pid must be set and refer to a live process.
+pid=$(echo "$entry" | jq -r '.pid')
+[[ -n $pid && $pid != null ]]
+kill -0 "$pid"
+
+# Graph view: one coordinator, whose graph holds the running dep, the waiting
+# top goal, and the waiter edge between them.
+graph=$(nix store builds --graph --json)
+echo "$graph" | jq .
+
+coord=$(echo "$graph" | jq --argjson pid "$pid" '.coordinators | map(select(.pid == $pid)) | .[0]')
+[[ $(echo "$coord" | jq -r '.roots | first') == *build-status-sleeper.drv ]]
+
+dep=$(echo "$coord" | jq '.goals | map(select(.id | endswith("build-status-dep.drv"))) | .[0]')
+[[ $(echo "$dep" | jq -r '.status') == running ]]
+[[ $(echo "$dep" | jq -r '.kind') == build ]]
+[[ $(echo "$dep" | jq -r '.startTime') != null ]]
+[[ $(echo "$dep" | jq -r '.waiters | first') == *build-status-sleeper.drv ]]
+
+top=$(echo "$coord" | jq '.goals | map(select(.id | endswith("build-status-sleeper.drv"))) | .[0]')
+[[ $(echo "$top" | jq -r '.status') == waiting ]]
+[[ $(echo "$top" | jq -r '.waiters | length') == 0 ]]
+
+# Once the dep finishes and the top goal starts building, the graph must keep
+# the dep as a completed goal.
+found=
+for _ in $(seq 1 150); do
+    if nix store builds --graph --json | jq -e \
+        'any(.coordinators[].goals[]; (.id | endswith("build-status-dep.drv")) and .status == "done")' > /dev/null; then
+        found=1
+        break
+    fi
+    sleep 0.2
+done
+[[ -n $found ]]
+nix store builds --graph --json | jq -e \
+    'any(.coordinators[].goals[]; (.id | endswith("build-status-sleeper.drv")) and .status == "running")' > /dev/null
+
+# Stop the build; the status directory must drain (the coordinator removes its
+# graph file on exit; `nix store builds` also prunes stale files as it reads).
+cleanup
+trap - EXIT
+
+empty=
+for _ in $(seq 1 150); do
+    if [[ $(nix store builds --json | jq 'length') == 0 && $(nix store builds --graph --json | jq '.coordinators | length') == 0 ]]; then
+        empty=1
+        break
+    fi
+    sleep 0.2
+done
+[[ -n $empty ]]
+
+echo "build-status.sh: OK"
