 };
 
+/**
+ * What a goal that is actively doing work (building or substituting) records
+ * about that work, for the goal-graph file (see the `build-status-dir`
+ * experimental feature). Held on the goal itself so its lifetime is exactly
+ * the goal's: a destroyed goal can never leave a stale entry behind.
+ */
+struct GoalRunningInfo
+{
+    time_t startTime;
+
+    /**
+     * The on-disk build log file, when one is being written.
+     */
+    std::optional<std::string> logFile;
+
+    /**
+     * The pid of the builder child process, for local builds.
+     */
+    std::optional<pid_t> builderPid;
+
+    /**
+     * The output names being produced, when known.
+     */
+    std::vector<std::string> outputs;
+};
+
 struct Goal : public std::enable_shared_from_this<Goal>
 {
 private:
@@ -94,6 +120,22 @@ public:
      */
     WeakGoals waiters;
 
+    /**
+     * Set while this goal is actively building or substituting, when the
+     * `build-status-dir` experimental feature is enabled. Read by the
+     * worker's @ref GoalGraph when rendering the graph file.
+     */
+    std::optional<GoalRunningInfo> runningStatus;
+
+    /**
+     * The goals this one is waiting for (read-only view, for the goal
+     * graph).
+     */
+    const Goals & getWaitees() const
+    {
+        return waitees;
+    }
+
     /**
      * Number of goals we are/were waiting for that have failed.
      */
