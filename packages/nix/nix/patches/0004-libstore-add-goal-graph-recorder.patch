diff --git a/src/libstore/include/nix/store/build/goal-graph.hh b/src/libstore/include/nix/store/build/goal-graph.hh
new file mode 100644
index 000000000..6a0169788
--- /dev/null
+++ b/src/libstore/include/nix/store/build/goal-graph.hh
@@ -0,0 +1,149 @@
+#pragma once
+///@file
+
+#include "nix/store/build/goal.hh"
+
+#include <chrono>
+#include <filesystem>
+#include <map>
+#include <optional>
+#include <set>
+#include <string>
+
+#include <sys/types.h>
+
+namespace nix {
+
+/**
+ * Identity of the client that requested the work this coordinator is doing.
+ *
+ * The daemon forks one worker process per client connection, so this is
+ * recorded once per connection as a process-global (see @ref
+ * setBuildStatusClientInfo) and stamped on the coordinator's goal-graph file.
+ */
+struct BuildStatusClientInfo
+{
+    std::optional<uid_t> uid;
+    std::optional<std::string> user;
+};
+
+/**
+ * Record the identity of the client for the current process. Called once per
+ * connection in the forked daemon worker. Safe to leave unset (e.g. for a
+ * local store with no daemon), in which case the recorded uid/user are null.
+ */
+void setBuildStatusClientInfo(BuildStatusClientInfo info);
+
+/**
+ * The directory into which goal-graph files are written, i.e.
+ * `<store-state-dir>/status`. Derived from `settings.nixStateDir`, so it
+ * honors `NIX_STATE_DIR`.
+ */
+std::filesystem::path buildStatusDir();
+
+/**
+ * Compute the path of the build log file for @p drvPath, using the exact same
+ * formula as the build log writer (see `LogFile` in
+ * derivation-building-goal.cc). Returns `std::nullopt` if build logs are not
+ * being kept.
+ */
+std::optional<std::filesystem::path> logFileFor(Store & store, const StorePath & drvPath, bool compress);
+
+/**
+ * Records the worker's entire goal graph to one `graph-<pid>.json` file under
+ * @ref buildStatusDir, so what this coordinator process is building, waiting
+ * on, and done with is globally observable without a daemon connection.
+ *
+ * The document is written atomically (write-to-temp + rename) and removed by
+ * the destructor when the coordinator's build session ends; a reader treats a
+ * file whose recorded pid is dead as stale (a crashed coordinator cannot lie).
+ *
+ * Contents: the coordinator pid, the requesting client's uid/user, the
+ * requested root goals, and one entry per goal the worker currently knows,
+ * with `status` (waiting/running/done/failed) and `waiters` edges (the parent
+ * goals waiting on it). Completed goals are kept for the session (ids plus
+ * their last-known edges) so the graph shows progress, not just remaining
+ * work.
+ *
+ * State changes mark the graph dirty ([`markDirty`]); the worker's run loop
+ * calls [`flush`], which rewrites the file at most about once per second. A
+ * ten-thousand-goal graph is a few MB of JSON, fine at that cadence.
+ *
+ * Instantiated ([`forCurrentProcess`]) only when the `build-status-dir`
+ * experimental feature is enabled; a null recorder means the feature is off.
+ */
+class GoalGraph
+{
+    std::filesystem::path path;
+
+    /**
+     * Whether goal state changed since the last flush. Starts true so the
+     * file exists as soon as the worker loop first flushes.
+     */
+    bool dirty = true;
+
+    bool everWrote = false;
+
+    std::chrono::steady_clock::time_point lastFlush;
+
+    /**
+     * A goal completed this session: its last-known edges and outcome, kept
+     * (id-keyed) after the goal object is gone so the graph still shows it.
+     * Cancelled goals (destroyed without completing) are deliberately absent.
+     */
+    struct Finished
+    {
+        std::string kind;
+        std::set<std::string> waiters;
+        std::set<std::string> outputs;
+        bool success;
+    };
+
+    std::map<std::string, Finished> finished;
+
+    GoalGraph();
+
+public:
+    /**
+     * The recorder for this process, or null when the `build-status-dir`
+     * experimental feature is disabled.
+     */
+    static std::unique_ptr<GoalGraph> forCurrentProcess();
+
+    GoalGraph(const GoalGraph &) = delete;
+    GoalGraph & operator=(const GoalGraph &) = delete;
+
+    ~GoalGraph();
+
+    /**
+     * Note that goal state changed; the next [`flush`] (throttle permitting)
+     * rewrites the file.
+     */
+    void markDirty()
+    {
+        dirty = true;
+    }
+
+    bool isDirty() const
+    {
+        return dirty;
+    }
+
+    /**
+     * Record a goal that completed (successfully or not), snapshotting its
+     * id, kind, outputs and waiter edges before `amDone` unlinks it from the
+     * graph. Called with the goal's `waiters` still intact. A goal that ends
+     * with `ecNoSubstituters` is not recorded: "couldn't substitute, will
+     * build instead" is expected control flow, not an outcome worth showing.
+     */
+    void goalFinished(Goal & goal, Store & store, Goal::ExitCode result);
+
+    /**
+     * Rewrite the graph file if dirty, at most about once per second. The
+     * live goals are enumerated from @p topGoals down through their waitees;
+     * writing never throws (observability must never break a build).
+     */
+    void flush(const Goals & topGoals, Store & store);
+};
+
+} // namespace nix
