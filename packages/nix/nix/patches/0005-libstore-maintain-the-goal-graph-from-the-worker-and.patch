@@ -8,6 +8,7 @@
 #include "nix/store/build-result.hh"
 #include "nix/store/realisation.hh"
 #include "nix/util/muxable-pipe.hh"
+#include "nix/store/build/goal-graph.hh"
 
 #include <functional>
 #include <future>
@@ -159,6 +160,13 @@ public:
     Store & evalStore;
     const WorkerSettings & settings;
 
+    /**
+     * Records this worker's entire goal graph to a `graph-<pid>.json` file
+     * under the build status directory. Null unless the `build-status-dir`
+     * experimental feature is enabled.
+     */
+    std::unique_ptr<GoalGraph> goalGraph;
+
     /**
      * Function to get the substituters to use for path substitution.
      *
diff --git a/src/libstore/unix/build/derivation-builder.cc b/src/libstore/unix/build/derivation-builder.cc
index fc877dd56..d7a7bb205 100644
--- a/src/libstore/unix/build/derivation-builder.cc
+++ b/src/libstore/unix/build/derivation-builder.cc
@@ -459,6 +459,13 @@ public:
 
     bool killChild() override;
 
+    std::optional<pid_t> builderPid() override
+    {
+        /* `Pid` holds -1 when there is no child. */
+        pid_t p = pid;
+        return p > 0 ? std::optional(p) : std::nullopt;
+    }
+
 private:
 
     bool decideWhetherDiskFull();
