From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: Andrew Gazelka <andrew.gazelka@gmail.com>
Date: Sat, 11 Jul 2026 21:07:35 -0700
Subject: [PATCH] fix(libcmd): preserve repeated installable cardinality

Build each derived path once, then map its result back to every request in input order. This prevents the build result backmap from multiplying aliases that resolve to the same derivation.

Refs indexable-inc/index#2633

Assisted-by: Codex <noreply@openai.com>

diff --git a/src/libcmd/installables.cc b/src/libcmd/installables.cc
index 8f8309bd9..947f71d06 100644
--- a/src/libcmd/installables.cc
+++ b/src/libcmd/installables.cc
@@ -24,6 +24,7 @@
 
 #include <regex>
 #include <queue>
+#include <set>
 
 #include <nlohmann/json.hpp>
 
@@ -609,13 +610,21 @@ std::vector<std::pair<ref<Installable>, BuiltPathWithResult>> Installable::build
         ref<Installable> installable;
     };
 
+    struct Request
+    {
+        DerivedPath path;
+        Aux aux;
+    };
+
+    std::vector<Request> requests;
     std::vector<DerivedPath> pathsToBuild;
-    std::map<DerivedPath, std::vector<Aux>> backmap;
+    std::set<DerivedPath> seenPaths;
 
     for (auto & i : installables) {
         for (auto b : i->toDerivedPaths()) {
-            pathsToBuild.push_back(b.path);
-            backmap[b.path].push_back({.info = b.info, .installable = i});
+            requests.push_back({b.path, {.info = b.info, .installable = i}});
+            if (seenPaths.insert(b.path).second)
+                pathsToBuild.push_back(std::move(b.path));
         }
     }
 
@@ -627,28 +636,28 @@ std::vector<std::pair<ref<Installable>, BuiltPathWithResult>> Installable::build
     case Realise::Derivation:
         printMissing(store, pathsToBuild, lvlError);
 
-        for (auto & path : pathsToBuild) {
-            for (auto & aux : backmap[path]) {
-                std::visit(
-                    overloaded{
-                        [&](const DerivedPath::Built & bfd) {
-                            auto outputs = resolveDerivedPath(*store, bfd, &*evalStore);
-                            res.push_back(
-                                {aux.installable,
-                                 {.path =
-                                      BuiltPath::Built{
-                                          .drvPath =
-                                              make_ref<SingleBuiltPath>(getBuiltPath(evalStore, store, *bfd.drvPath)),
-                                          .outputs = outputs,
-                                      },
-                                  .info = aux.info}});
-                        },
-                        [&](const DerivedPath::Opaque & bo) {
-                            res.push_back({aux.installable, {.path = BuiltPath::Opaque{bo.path}, .info = aux.info}});
-                        },
+        for (auto & request : requests) {
+            auto & path = request.path;
+            auto & aux = request.aux;
+            std::visit(
+                overloaded{
+                    [&](const DerivedPath::Built & bfd) {
+                        auto outputs = resolveDerivedPath(*store, bfd, &*evalStore);
+                        res.push_back(
+                            {aux.installable,
+                             {.path =
+                                  BuiltPath::Built{
+                                      .drvPath =
+                                          make_ref<SingleBuiltPath>(getBuiltPath(evalStore, store, *bfd.drvPath)),
+                                      .outputs = outputs,
+                                  },
+                              .info = aux.info}});
                     },
-                    path.raw());
-            }
+                    [&](const DerivedPath::Opaque & bo) {
+                        res.push_back({aux.installable, {.path = BuiltPath::Opaque{bo.path}, .info = aux.info}});
+                    },
+                },
+                path.raw());
         }
 
         break;
@@ -659,35 +668,42 @@ std::vector<std::pair<ref<Installable>, BuiltPathWithResult>> Installable::build
 
         auto buildResults = store->buildPathsWithResults(pathsToBuild, bMode, evalStore);
         throwBuildErrors(buildResults, *store);
-        for (auto & buildResult : buildResults) {
-            // If we didn't throw, they must all be sucesses
+        std::map<DerivedPath, KeyedBuildResult> resultsByPath;
+        for (auto & buildResult : buildResults)
+            resultsByPath.emplace(buildResult.path, std::move(buildResult));
+
+        for (auto & request : requests) {
+            auto result = resultsByPath.find(request.path);
+            if (result == resultsByPath.end())
+                continue;
+            auto & buildResult = result->second;
+            auto & aux = request.aux;
+            // If we didn't throw, they must all be successes.
             auto & success = std::get<nix::BuildResult::Success>(buildResult.inner);
-            for (auto & aux : backmap[buildResult.path]) {
-                std::visit(
-                    overloaded{
-                        [&](const DerivedPath::Built & bfd) {
-                            std::map<std::string, StorePath> outputs;
-                            for (auto & [outputName, realisation] : success.builtOutputs)
-                                outputs.emplace(outputName, realisation.outPath);
-                            res.push_back(
-                                {aux.installable,
-                                 {.path =
-                                      BuiltPath::Built{
-                                          .drvPath =
-                                              make_ref<SingleBuiltPath>(getBuiltPath(evalStore, store, *bfd.drvPath)),
-                                          .outputs = outputs,
-                                      },
-                                  .info = aux.info,
-                                  .result = buildResult}});
-                        },
-                        [&](const DerivedPath::Opaque & bo) {
-                            res.push_back(
-                                {aux.installable,
-                                 {.path = BuiltPath::Opaque{bo.path}, .info = aux.info, .result = buildResult}});
-                        },
+            std::visit(
+                overloaded{
+                    [&](const DerivedPath::Built & bfd) {
+                        std::map<std::string, StorePath> outputs;
+                        for (auto & [outputName, realisation] : success.builtOutputs)
+                            outputs.emplace(outputName, realisation.outPath);
+                        res.push_back(
+                            {aux.installable,
+                             {.path =
+                                  BuiltPath::Built{
+                                      .drvPath =
+                                          make_ref<SingleBuiltPath>(getBuiltPath(evalStore, store, *bfd.drvPath)),
+                                      .outputs = outputs,
+                                  },
+                              .info = aux.info,
+                              .result = buildResult}});
                     },
-                    buildResult.path.raw());
-            }
+                    [&](const DerivedPath::Opaque & bo) {
+                        res.push_back(
+                            {aux.installable,
+                             {.path = BuiltPath::Opaque{bo.path}, .info = aux.info, .result = buildResult}});
+                    },
+                },
+                buildResult.path.raw());
         }
 
         break;
diff --git a/tests/functional/build.sh b/tests/functional/build.sh
index 0e76f949f..52bf445d7 100755
--- a/tests/functional/build.sh
+++ b/tests/functional/build.sh
@@ -19,6 +19,14 @@ nix build -f multiple-outputs.nix --json a b --no-link | jq --exit-status '
       (.out | match(".*multiple-outputs-b"))))
 '
 
+# Repeated installables should produce one result each in request order.
+nix build -f multiple-outputs.nix --json a b a --no-link | jq --exit-status '
+  length == 3
+  and (.[0].drvPath | match(".*multiple-outputs-a.drv"))
+  and (.[1].drvPath | match(".*multiple-outputs-b.drv"))
+  and (.[2].drvPath | match(".*multiple-outputs-a.drv"))
+'
+
 # Test output selection using the '^' syntax.
 nix build -f multiple-outputs.nix --json a^first --no-link | jq --exit-status '
   (.[0] |
