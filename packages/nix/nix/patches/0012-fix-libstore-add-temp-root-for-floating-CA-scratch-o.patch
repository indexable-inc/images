index 391e98d..ab5d9ca 100644
--- a/tests/functional/ca/meson.build
+++ b/tests/functional/ca/meson.build
@@ -19,6 +19,7 @@ suites += {
     'eval-store.sh',
     'gc.sh',
     'gc-during-build.sh',
+    'gc-scratch-output.sh',
