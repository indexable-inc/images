From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: Andrew Gazelka <andrew.gazelka@gmail.com>
Date: Sat, 11 Jul 2026 20:51:47 -0700
Subject: [PATCH] nix: expose stable application package

Refs indexable-inc/index#2893.

(authored by an AI agent via Codex)

diff --git a/nix/build.nix b/nix/build.nix
index c01d869fdd..3ba254863e 100644
--- a/nix/build.nix
+++ b/nix/build.nix
@@ -56,9 +56,15 @@
   withGLES ? false,
   profile ? "release",
   commitSha ? null,
+  channel ? "nightly",
 }:
 assert withGLES -> stdenv.hostPlatform.isLinux;
+assert builtins.elem channel [
+  "nightly"
+  "stable"
+];
 let
+  appName = if channel == "stable" then "Zed" else "Zed Nightly";
   mkIncludeFilter =
     root': path: type:
     let
@@ -90,8 +96,10 @@ let
       pname = "zed-editor";
       version =
         zedCargoLock.package.version
-        + "-nightly"
-        + lib.optionalString (commitSha != null) "+${builtins.substring 0 7 commitSha}";
+        + lib.optionalString (channel != "stable") "-${channel}"
+        +
+          lib.optionalString (channel != "stable" && commitSha != null)
+            "+${builtins.substring 0 7 commitSha}";
       src = builtins.path {
         path = ../.;
         filter = mkIncludeFilter ../.;
@@ -325,7 +333,7 @@ craneLib.buildPackage (
     # TODO: put this in a separate derivation that depends on src to avoid running it on every build
     preBuild = ''
       ALLOW_MISSING_LICENSES=yes bash script/generate-licenses
-      echo nightly > crates/zed/RELEASE_CHANNEL
+      echo ${channel} > crates/zed/RELEASE_CHANNEL
     '';
 
     installPhase =
@@ -334,7 +342,7 @@ craneLib.buildPackage (
           runHook preInstall
 
           pushd crates/zed
-          sed -i "s/package.metadata.bundle-nightly/package.metadata.bundle/" Cargo.toml
+          sed -i "s/package.metadata.bundle-${channel}/package.metadata.bundle/" Cargo.toml
           export CARGO_BUNDLE_SKIP_BUILD=true
           app_path="$(cargo bundle --profile $CARGO_PROFILE | xargs)"
           popd
@@ -347,7 +355,7 @@ craneLib.buildPackage (
 
           # Physical location of the CLI must be inside the app bundle as this is used
           # to determine which app to start
-          ln -s "$out/Applications/Zed Nightly.app/Contents/MacOS/cli" $out/bin/zed
+          ln -s "$out/Applications/${appName}.app/Contents/MacOS/cli" $out/bin/zed
 
           runHook postInstall
         ''
diff --git a/nix/modules/packages.nix b/nix/modules/packages.nix
index 5c9b7391d1..93b4f8dbf4 100644
--- a/nix/modules/packages.nix
+++ b/nix/modules/packages.nix
@@ -15,6 +15,9 @@
       packages = {
         default = zed-editor;
         debug = zed-editor.override { profile = "dev"; };
+      }
+      // lib.optionalAttrs pkgs.stdenv.hostPlatform.isDarwin {
+        stable = zed-editor.override { channel = "stable"; };
       };
     }
     // lib.optionalAttrs (lib.hasSuffix "linux" system) {
