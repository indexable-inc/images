#!/usr/bin/env bash
# Repo commit-msg hook. Activated via .envrc setting core.hooksPath.
#
# Every commit must point at a site page that explains the change
# (https://github.com/indexable-inc/index/issues/3611). The commit
# message stays short; the long-form description lives on the page.
# Reference the page by repo path, e.g.:
#
#   packages/site/src/lib/updates/file-search.svx
#
# Merge, fixup, squash, and revert commits are exempt: they carry
# their own context.
set -euo pipefail

msg_file=$1
subject=$(sed -n '1p' "$msg_file")

case $subject in
  Merge\ * | fixup!* | squash!* | Revert\ *) exit 0 ;;
esac

pattern='packages/site/src/lib/(updates|plans|stories)/[A-Za-z0-9._-]+\.svx'
mapfile -t pages < <(grep -oE "$pattern" "$msg_file" | sort -u)

if [ "${#pages[@]}" -eq 0 ]; then
  cat >&2 <<'EOF'
commit-msg: no site page referenced.

Every commit must include a repo path to a site page that explains it,
e.g. packages/site/src/lib/updates/<slug>.svx (also plans/ or stories/).
Add a page for the change, or point at the existing page it extends,
and put the path anywhere in the commit message.
EOF
  exit 1
fi

for page in "${pages[@]}"; do
  # :path checks the staged tree, so a page added in this commit counts.
  if git cat-file -e ":$page" 2>/dev/null; then
    exit 0
  fi
done

printf 'commit-msg: referenced site page(s) not found in this commit:\n' >&2
printf '  %s\n' "${pages[@]}" >&2
exit 1
